{
  "name": "qa-agentic-rag",
  "version": "1.0.0",
  "description": "Agentic RAG assistant for QA test design, coverage gaps, and change-impact analysis",
  "main": "index.js",
  "scripts": {
    "test": "npm run qa:smoke",
    "postinstall": "node scripts/patch-qdrant-undici.mjs",
    "qa:agentic": "tsx qa-agentic-rag/cli.ts",
    "qa:server": "tsx qa-agentic-rag/server.ts",
    "qa:server:prod": "QA_ENV=production NODE_ENV=production tsx qa-agentic-rag/server.ts",
    "qa:smoke": "tsx qa-agentic-rag/eval/prodSmoke.ts",
    "qa:studio": "npx @langchain/langgraph-cli dev",
    "qa:docker:up": "docker compose up --build -d",
    "qa:docker:down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.0.0",
    "@langchain/community": "^1.0.2",
    "@langchain/core": "^1.0.4",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.0.2",
    "@langchain/langgraph-cli": "^1.0.3",
    "@langchain/mcp-adapters": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/qdrant": "^1.0.3",
    "@langchain/textsplitters": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "@qdrant/js-client-rest": "^1.18.0",
    "@types/node": "24.10.0",
    "dotenv": "^16.4.5",
    "langchain": "^1.0.3",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.19.1"
  }
}
