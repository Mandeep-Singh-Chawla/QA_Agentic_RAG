GOOGLE_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=qa-agentic-rag

# --- Runtime mode ---
# development | production  (production fails boot if secrets/CORS/qdrant missing)
QA_ENV=development
# NODE_ENV=development
QA_LOG_LEVEL=info
QA_CORS_ORIGINS=http://localhost:3000
QA_MAX_BODY_BYTES=1000000

# Gemini free-tier helpers (avoid exhausted gemini-3.5-flash 20/day quota)
QA_CHAT_MODEL=google-genai:gemini-3-flash-preview
QA_LITE_MODEL=google-genai:gemini-3.5-flash-lite
QA_RERANK=false
QA_SOURCE_LLM=false
QA_MAX_SOURCES=2

# --- Vector DB (default memory; use qdrant for free prod-like persistence) ---
# memory | qdrant
VECTOR_BACKEND=memory
# Local free: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Cloud free: https://cloud.qdrant.io → paste URL + API key
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qa_agentic
# gemini-embedding-001 size
EMBEDDING_DIM=3072

# --- GitHub live API (account: Mandeep-Singh-Chawla) ---
# Required for PR diffs / avoiding 60 req/hr unauthenticated rate limit
# Create: https://github.com/settings/tokens (classic, scope: public_repo)
GITHUB_TOKEN=
GITHUB_USER=Mandeep-Singh-Chawla
# optional: sync only one repo instead of top user repos
# GITHUB_REPO=Mandeep-Singh-Chawla/Selenium-Framework

# --- Change-impact test selection ---
# Dev application repo (code changes)
DEV_REPO=confident-ai/deepeval
# QA automation repos (comma-separated owner/name)
AUTOMATION_REPOS=Mandeep-Singh-Chawla/Selenium-Framework,Mandeep-Singh-Chawla/RestAssured-Framework-and-Important-Utilities,Mandeep-Singh-Chawla/Appium-Framework
# Set false to skip LLM refine (heuristics only)
# QA_IMPACT_LLM=true

# --- Jira / Confluence live API (site: mandeepsingh1986.atlassian.net) ---
# Create token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://mandeepsingh1986.atlassian.net
JIRA_EMAIL=mandeepsingh1986@gmail.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
# Required for Jira webhooks (or set QA_ALLOW_INSECURE_WEBHOOK=true for local-only)
JIRA_WEBHOOK_SECRET=
# QA_ALLOW_INSECURE_WEBHOOK=false

# --- HTTP API guardrails (qa:server) ---
# Bearer token for /query /ingest /sync (enforced when set, or when QA_ENV=production / QA_REQUIRE_AUTH=true)
QA_API_TOKEN=
# QA_REQUIRE_AUTH=false
# QA_ENV=development
# Rate limit: max requests per window per client IP
QA_RATE_LIMIT_MAX=60
QA_RATE_LIMIT_WINDOW_MS=60000
# Hard-fail RAG answers with no sources for grounding-required intents
QA_REQUIRE_GROUNDING=true

# optional Confluence space filter
# CONFLUENCE_SPACE_KEY=

# --- Xray (optional) ---
# Jira → Apps → Xray → API Keys
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=
