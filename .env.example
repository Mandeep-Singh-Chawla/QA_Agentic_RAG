# Create: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Create: https://smith.langchain.com/settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=qa-agentic-rag

# --- Runtime mode ---
# development | production  (production fails boot if secrets/CORS/qdrant missing)
QA_ENV=development
# NODE_ENV=development
QA_LOG_LEVEL=info
QA_CORS_ORIGINS=http://localhost:3000
QA_MAX_BODY_BYTES=1000000

# Gemini free-tier helpers (avoid exhausted gemini-3.5-flash 20/day quota)
QA_CHAT_MODEL=google-genai:gemini-3-flash-preview
QA_LITE_MODEL=google-genai:gemini-3.5-flash-lite
QA_RERANK=false
QA_SOURCE_LLM=false
QA_MAX_SOURCES=2

# --- Vector DB (default memory; use qdrant for free prod-like persistence) ---
# memory | qdrant
VECTOR_BACKEND=memory
# Local free: docker run -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Cloud free tier + API key: https://cloud.qdrant.io
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=qa_agentic
# gemini-embedding-001 size
EMBEDDING_DIM=3072

# --- GitHub live API (each team fills their own — do not commit real values) ---
# Create PAT: https://github.com/settings/tokens (classic; scope: public_repo or repo)
GITHUB_TOKEN=
# User or org whose repos to list/sync
GITHUB_USER=
# optional: sync only one repo instead of top user/org repos
# GITHUB_REPO=your-org/your-repo

# --- Change-impact (DEV app vs QA automation) ---
# Application under test — where PRs/code changes come from (owner/name)
DEV_REPO=
# QA automation repos that hold automated tests (comma-separated owner/name)
AUTOMATION_REPOS=
# Example:
# DEV_REPO=your-org/payments-api
# AUTOMATION_REPOS=your-org/ui-tests,your-org/api-tests
# Set false to skip LLM refine (heuristics only)
# QA_IMPACT_LLM=true

# --- Jira / Confluence live API ---
# Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Required for Jira webhooks (or set QA_ALLOW_INSECURE_WEBHOOK=true for local-only)
JIRA_WEBHOOK_SECRET=
# QA_ALLOW_INSECURE_WEBHOOK=false

# --- HTTP API guardrails (qa:server) ---
# Bearer token for /query /ingest /sync (enforced when set, or when QA_ENV=production / QA_REQUIRE_AUTH=true)
QA_API_TOKEN=
# QA_REQUIRE_AUTH=false
# Rate limit: max requests per window per client IP
QA_RATE_LIMIT_MAX=60
QA_RATE_LIMIT_WINDOW_MS=60000
# Hard-fail RAG answers with no sources for grounding-required intents
QA_REQUIRE_GROUNDING=true

# optional Confluence space filter
# CONFLUENCE_SPACE_KEY=

# --- Xray (optional) ---
# Create keys in Jira → Apps → Xray → API Keys
# Docs: https://docs.getxray.app/display/XRAYCLOUD/Authentication+-+REST+API+v2
# XRAY_CLIENT_ID=
# XRAY_CLIENT_SECRET=
